# PostgreSQL connection string (Supabase). Server-only — never expose to the client
# or prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host:5432/database

# Temporary development-only scaffolding (see src/composition/development-owner.ts).
# Must be the id of a seeded user (see src/db/seed/data.ts). This is NOT
# authentication — it stands in for a real session until Supabase Auth is
# implemented, and is refused outright when NODE_ENV=production.
DEVELOPMENT_OWNER_ID=00000000-0000-0000-0000-000000000001
