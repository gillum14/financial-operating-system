# PostgreSQL connection string (Supabase). Server-only — never expose to the client
# or prefix with NEXT_PUBLIC_.
#
# WARNING: never run DB-backed tests against this directly. `npm test`
# never touches a database at all; `npm run test:db` / `npm run test:full`
# use TEST_DATABASE_URL below instead, and refuse to run without it. See
# the 2026-08-06 data-loss incident in docs/testing.md — a test file's
# cleanup step used this same connection with an under-scoped DELETE and
# wiped real seeded data. That bug is fixed, but DATABASE_URL is still the
# app's live connection and should not casually be treated as disposable.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. When set, `npm run db:generate` / `npm run db:migrate` connect
# through this instead of DATABASE_URL. Migrations are administrative DDL
# and run better over a direct, non-pooled connection (port 5432) than
# through the app's pooled PgBouncer connection (DATABASE_URL, typically
# port 6543 on Supabase) — see docs/testing.md. Falls back to DATABASE_URL
# when unset; nothing changes if you don't set this.
MIGRATION_DATABASE_URL=

# Required to run any DB-backed test (npm run test:db / test:full). Never
# used as a fallback for DATABASE_URL and vice versa — DB-backed tests
# refuse to run at all if this is unset (see
# src/infrastructure/db/test-support/db-test-guard.ts). Prefer a genuinely
# separate database if you have one; a direct (port 5432, non-pooled)
# connection is preferred over a pooled one for the same reason as
# MIGRATION_DATABASE_URL above. If you only have one database available
# (this project's current situation), you may point this at the same
# value as DATABASE_URL, but you must also set
# ALLOW_DB_TESTS_AGAINST_DEV_DATABASE=true below to acknowledge that
# choice — the guard refuses silently proceeding on an identical URL.
TEST_DATABASE_URL=

# Required (must be exactly "true") to run any DB-backed test at all. Not
# a convenience default — the point is that a human has to deliberately
# opt in every time, not that a project script quietly sets it. Set by
# `npm run test:db` / `npm run test:full` automatically; only export it
# yourself if you're invoking vitest directly against a DB-gated file.
ALLOW_DB_TESTS=

# Only needed if TEST_DATABASE_URL is identical to DATABASE_URL (no
# separate test database configured) — see TEST_DATABASE_URL above. Must
# be exactly "true". Leave unset if you have a genuinely separate test
# database.
ALLOW_DB_TESTS_AGAINST_DEV_DATABASE=

# Supabase project URL and anon (publishable) key, from Project Settings ->
# API in the Supabase dashboard. Both are safe for browser exposure by
# design (NEXT_PUBLIC_) — the anon key is subject to Row Level Security,
# not a secret on its own. Never put the service-role key here or anywhere
# NEXT_PUBLIC_-prefixed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. The app's own origin, used to build absolute email-
# confirmation/password-reset redirect URLs. Must be listed in Supabase's
# Auth redirect URL allowlist (Authentication -> URL Configuration) and
# match the configured Site URL in production. Defaults to
# http://localhost:3000 for local development.
SITE_URL=http://localhost:3000

# Required only by `npm run db:seed`, not by the app itself. Must be the id
# of a real Supabase Auth user you created (e.g. by signing up through the
# app locally) — see docs for the development seeding strategy. Seed data is
# attached to this owner; it is never a fabricated/production-style identity.
SEED_OWNER_ID=

# Required only by the real JWT-backed RLS integration tests
# (src/lib/supabase/rls-policies.jwt.test.ts) — not by the app itself, and
# not by the direct role-simulation RLS tests
# (src/infrastructure/db/rls-policies.test.ts). Both are DB-backed tests
# gated behind ALLOW_DB_TESTS + TEST_DATABASE_URL (see above) regardless of
# these being set. Must be two confirmed, non-production Supabase Auth
# test users that already exist in the target project — this file signs in
# as them, it does not create them. Never use production credentials or
# real personal email addresses here.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
